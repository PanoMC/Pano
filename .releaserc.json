{
  "branches": [
    {
      "name": "alpha",
      "prerelease": "alpha",
      "channel": "alpha"
    },
    {
      "name": "beta",
      "prerelease": "beta",
      "channel": "beta"
    },
    "main"
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          {
            "type": "chore",
            "scope": "ui",
            "release": "patch"
          }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "draftRelease": true
      }
    ]
  ],
  "repositoryUrl": "https://github.com/panomc/pano.git"
}
