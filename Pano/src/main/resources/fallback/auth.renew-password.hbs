{{pageTitle t.renewPassword.title}}
<h1 class="pano-fb-title">{{t.renewPassword.heading}}</h1>
<form class="pano-fb-form" data-pano-endpoint="/auth/renew-password" data-pano-busy="{{t.common.working}}">
  <p class="pano-fb-lead" data-pano-hide-on-done>{{t.renewPassword.lead}}</p>
  <input type="hidden" name="token" value="{{token}}">
  <label class="pano-fb-field" data-pano-hide-on-done>
    <span>{{t.renewPassword.newPassword}}</span>
    <input type="password" name="newPassword" autocomplete="new-password" required>
  </label>
  <label class="pano-fb-field" data-pano-hide-on-done>
    <span>{{t.renewPassword.newPasswordRepeat}}</span>
    <input type="password" name="newPasswordRepeat" autocomplete="new-password" required>
  </label>
  <p class="pano-fb-message" data-pano-message role="alert" hidden></p>
  <button type="submit" class="pano-fb-button" data-pano-hide-on-done>{{t.renewPassword.button}}</button>
  <div class="pano-fb-done" data-pano-done hidden>
    <p class="pano-fb-lead">{{t.renewPassword.done}}</p>
    {{#if loginUrl}}<a class="pano-fb-button" href="{{loginUrl}}">{{t.common.signIn}}</a>{{/if}}
  </div>
</form>
