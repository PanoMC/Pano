{
  "mails": [
    {
      "key": "activation",
      "name": {
        "en-US": "Account activation",
        "tr": "Hesap etkinleştirme",
        "ru": "Активация аккаунта"
      },
      "description": {
        "en-US": "Sent after registration so the user confirms their e-mail address.",
        "tr": "Kayıttan sonra kullanıcının e-posta adresini doğrulaması için gönderilir.",
        "ru": "Отправляется после регистрации, чтобы пользователь подтвердил адрес почты."
      },
      "variants": [
        {
          "key": "default",
          "name": {
            "en-US": "Default",
            "tr": "Varsayılan",
            "ru": "По умолчанию"
          },
          "variables": [
            {
              "name": "username",
              "type": "text",
              "label": {
                "en-US": "Username",
                "tr": "Kullanıcı adı",
                "ru": "Имя пользователя"
              },
              "sample": "Steve"
            },
            {
              "name": "email",
              "type": "text",
              "label": {
                "en-US": "E-mail address",
                "tr": "E-posta adresi",
                "ru": "Адрес почты"
              },
              "sample": "steve@example.com"
            },
            {
              "name": "activationLink",
              "type": "url",
              "label": {
                "en-US": "Activation link",
                "tr": "Etkinleştirme bağlantısı",
                "ru": "Ссылка активации"
              },
              "sample": "https://example.com/activate?token=abc123"
            },
            {
              "name": "expiresInMinutes",
              "type": "number",
              "label": {
                "en-US": "Expires in (minutes)",
                "tr": "Geçerlilik süresi (dakika)",
                "ru": "Срок действия (мин.)"
              },
              "sample": 15
            }
          ]
        }
      ]
    },
    {
      "key": "change-email",
