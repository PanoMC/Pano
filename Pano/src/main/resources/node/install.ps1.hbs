# Pano node installer for Windows, generated by Pano {{{version}}}.
#
# Installs the pano-node daemon on this host and pairs it with the Pano that served this script.
# Safe to run again: everything it does is checked first, so a second run repairs an install
# rather than duplicating it.
#
#   & ([scriptblock]::Create((Invoke-RestMethod 'https://pano.example.com/api/node/install.ps1'))) -Pano 'https://pano.example.com' -Code '123456'
#
param(
    [Parameter(Mandatory = $true)][string] $Pano,
    [string] $Code = '',
    [string] $BootstrapToken = '',
    [string] $Name = '',
    [string] $InstallDir = "$env:ProgramFiles\PanoNode",
    [string] $DataDir = "$env:ProgramData\PanoNode",
    [switch] $UserInstall
)

$ErrorActionPreference = 'Stop'

$PanoVersion = '{{{version}}}'
$JarUrl = '{{{downloadUrl}}}'
$ShaUrl = '{{{checksumUrl}}}'
$JarName = '{{{jarName}}}'
$ServiceName = 'PanoNode'
$MinJava = 17

function Write-Step($message) {
    Write-Host "pano-node: $message"
}

function Fail($message) {
    Write-Error "pano-node: $message"
    exit 1
}

# A six-digit code is the rotating pairing code from the panel; anything longer is a one-time
# bootstrap token, and the daemon takes the two on different flags.
if (-not $BootstrapToken -and $Code -and ($Code -notmatch '^[0-9]{6}$')) {
    $BootstrapToken = $Code
    $Code = ''
}

$isAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole(
    [Security.Principal.WindowsBuiltInRole]::Administrator)

if (-not $isAdmin -and -not $UserInstall) {
    Fail 'Run this from an elevated PowerShell, or pass -UserInstall to install under your profile without a service.'
}

if ($UserInstall) {
    $InstallDir = Join-Path $env:LOCALAPPDATA 'PanoNode'
    $DataDir = Join-Path $InstallDir 'data'
}

# ------------------------------------------------------------------------------------------ java

function Find-Java {
    if ($env:JAVA_HOME) {
        $candidate = Join-Path $env:JAVA_HOME 'bin\java.exe'

        if (Test-Path $candidate) {
            return $candidate
        }
    }

    $command = Get-Command java.exe -ErrorAction SilentlyContinue

    if ($command) {
        return $command.Source
    }

    return $null
}

function Get-JavaMajor($javaPath) {
    $output = & $javaPath -version 2>&1 | Select-Object -First 1

    if ($output -match 'version "([0-9]+)') {
        return [int] $Matches[1]
    }

    return 0
}

$javaBin = Find-Java

if (-not $javaBin -or (Get-JavaMajor $javaBin) -lt $MinJava) {
    if ($isAdmin -and (Get-Command winget.exe -ErrorAction SilentlyContinue)) {
        Write-Step 'Installing a Java runtime with winget.'

        & winget.exe install --id EclipseAdoptium.Temurin.21.JRE --silent --accept-package-agreements --accept-source-agreements | Out-Null

        $javaBin = Find-Java
    }

    if (-not $javaBin -or (Get-JavaMajor $javaBin) -lt $MinJava) {
        Fail "Java $MinJava or newer is required. Install Temurin $MinJava+ from https://adoptium.net and run this again."
    }
}

Write-Step "Using Java at $javaBin."

# ------------------------------------------------------------------------------------- the jar

New-Item -ItemType Directory -Force -Path $InstallDir | Out-Null
New-Item -ItemType Directory -Force -Path $DataDir | Out-Null

$targetJar = Join-Path $InstallDir $JarName
$expectedSha = ''

try {
    $expectedSha = ((Invoke-RestMethod -Uri $ShaUrl).ToString().Trim() -split '\s+')[0]
} catch {
    Write-Step 'The release publishes no checksum; the download cannot be verified.'
}

$needDownload = $true

if ((Test-Path $targetJar) -and $expectedSha) {
    $current = (Get-FileHash -Algorithm SHA256 -Path $targetJar).Hash

    if ($current -ieq $expectedSha) {
        $needDownload = $false
        Write-Step "$targetJar is already up to date."
    }
}

if ($needDownload) {
    Write-Step "Downloading pano-node $PanoVersion."

    $temp = Join-Path ([System.IO.Path]::GetTempPath()) ([System.IO.Path]::GetRandomFileName() + '.jar')

    Invoke-WebRequest -Uri $JarUrl -OutFile $temp -UseBasicParsing

    if ($expectedSha) {
        $actual = (Get-FileHash -Algorithm SHA256 -Path $temp).Hash

        if ($actual -ine $expectedSha) {
            Remove-Item $temp -Force
            Fail 'The downloaded jar does not match its published checksum.'
        }

        Write-Step 'Checksum verified.'
    }

    Move-Item -Force $temp $targetJar
}

# --------------------------------------------------------------------------------- the service

$arguments = "-jar `"$targetJar`" --data `"$DataDir`" --pano `"$Pano`""

if ($Code) {
    $arguments += " --code `"$Code`""
}

if ($BootstrapToken) {
    $arguments += " --bootstrap-token `"$BootstrapToken`""
}

if ($Name) {
    $arguments += " --name `"$Name`""
}

if ($UserInstall) {
    Write-Step "Installed to $InstallDir."
    Write-Step 'Start it with:'
    Write-Step "  & `"$javaBin`" $arguments"
    exit 0
}

# sc.exe can only register an executable, so the service points at a wrapper that launches the
# JVM with the jar. The wrapper also keeps the pairing credential out of the service's command
# line, where every user on the host could read it.
$wrapper = Join-Path $InstallDir 'pano-node-service.cmd'

@"
@echo off
"$javaBin" $arguments
"@ | Set-Content -Path $wrapper -Encoding ASCII

$existing = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue

if ($existing) {
    Write-Step 'Updating the existing service.'

    & sc.exe stop $ServiceName | Out-Null
    Start-Sleep -Seconds 2
} else {
    & sc.exe create $ServiceName binPath= "cmd.exe /c `"$wrapper`"" start= auto DisplayName= 'Pano node daemon' | Out-Null
    & sc.exe description $ServiceName "Installs and supervises Minecraft servers for a Pano platform." | Out-Null
}

& sc.exe start $ServiceName | Out-Null

Write-Step 'pano-node is installed and running.'
Write-Step "Check it with: Get-Service $ServiceName"
