#!/bin/sh
# Pano node installer, generated by Pano {{{version}}}.
#
# Installs the pano-node daemon on this host and pairs it with the Pano that served this script.
# Safe to run again: everything it does is checked first, so a second run repairs an install
# rather than duplicating it.
#
#   curl -fsSL https://pano.example.com/api/node/install.sh | sh -s -- --pano https://pano.example.com --code 123456
#
set -eu

PANO_URL=""
PAIR_CODE=""
BOOTSTRAP_TOKEN=""
NODE_NAME=""
USER_INSTALL=0

PANO_VERSION="{{{version}}}"
# Points at the Pano that served this script when that Pano has the daemon on disk, and at the
# matching GitHub release otherwise. Either way it is downloaded and checked against SHA_URL.
JAR_URL="{{{downloadUrl}}}"
SHA_URL="{{{checksumUrl}}}"
JAR_NAME="{{{jarName}}}"

SERVICE_USER="pano-node"
SERVICE_NAME="pano-node"
MIN_JAVA=17

log() {
    echo "pano-node: $1"
}

die() {
    echo "pano-node: $1" >&2
    exit 1
}

usage() {
    cat <<'USAGE'
Usage: install.sh --pano <url> [--code <pairing code>] [--name <node name>] [--user-install]

  --pano <url>              the Pano this node reports to (required)
  --code <code>             pairing code from Panel -> Servers -> Nodes, or a bootstrap token
  --bootstrap-token <token> one-time token, when Pano issued one instead of a code
  --name <name>             what this node is called in the panel (default: the hostname)
  --user-install            install under $HOME without root and without a system service
  --help                    print this text

A Pano Agent for one existing server is not installed with this script: download pano-agent.jar
into that server's folder and run it there (Panel -> Servers -> Add server -> Pano Agent).
USAGE
}

while [ $# -gt 0 ]; do
    case "$1" in
        --pano|--platform)
            [ $# -ge 2 ] || die "--pano needs a value."
            PANO_URL="$2"
            shift 2
            ;;
        --code|--pair|--pairing-code)
            [ $# -ge 2 ] || die "--code needs a value."
            PAIR_CODE="$2"
            shift 2
            ;;
        --bootstrap-token)
            [ $# -ge 2 ] || die "--bootstrap-token needs a value."
            BOOTSTRAP_TOKEN="$2"
            shift 2
            ;;
        --name)
            [ $# -ge 2 ] || die "--name needs a value."
            NODE_NAME="$2"
            shift 2
            ;;
        --user-install)
            USER_INSTALL=1
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            die "Unknown option \"$1\". Run with --help."
            ;;
    esac
done

[ -n "$PANO_URL" ] || die "Missing --pano <url>."

# A six-digit code is the rotating pairing code an admin read out of the panel; anything longer
# is a one-time bootstrap token Pano minted itself, and the daemon takes the two on different
# flags. Deciding here means the one-line command is the same either way.
if [ -z "$BOOTSTRAP_TOKEN" ] && [ -n "$PAIR_CODE" ]; then
    case "$PAIR_CODE" in
        [0-9][0-9][0-9][0-9][0-9][0-9]) ;;
        *)
            BOOTSTRAP_TOKEN="$PAIR_CODE"
            PAIR_CODE=""
            ;;
    esac
fi

IS_ROOT=0
if [ "$(id -u)" -eq 0 ]; then
    IS_ROOT=1
fi

# Refused rather than guessed: installing under the invoking user when root was meant leaves a
# node that dies with the session, and that is worse than stopping with an explanation.
if [ "$IS_ROOT" -eq 0 ] && [ "$USER_INSTALL" -eq 0 ]; then
    die "Run this as root (sudo sh -s -- ...) or pass --user-install to install under $HOME."
fi

if [ "$USER_INSTALL" -eq 1 ]; then
    INSTALL_DIR="${HOME}/.pano-node"
    DATA_DIR="${HOME}/.pano-node/data"
else
    INSTALL_DIR="/opt/pano-node"
    DATA_DIR="/var/lib/pano-node"
fi

# ----------------------------------------------------------------------------------- downloads

download() {
    _url="$1"
    _target="$2"

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$_url" -o "$_target"
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O "$_target" "$_url"
    else
        die "Neither curl nor wget is installed."
    fi
}

download_optional() {
    _url="$1"
    _target="$2"

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$_url" -o "$_target" 2>/dev/null || return 1
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O "$_target" "$_url" 2>/dev/null || return 1
    else
        return 1
    fi

    return 0
}

sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | cut -d' ' -f1
    else
        echo ""
    fi
}

# ---------------------------------------------------------------------------------------- java

java_major() {
    _java="$1"

    "$_java" -version 2>&1 | head -n 1 | sed -n 's/.*version "\([0-9][0-9]*\).*/\1/p'
}

find_java() {
    if [ -n "${JAVA_HOME:-}" ] && [ -x "${JAVA_HOME}/bin/java" ]; then
        echo "${JAVA_HOME}/bin/java"
        return 0
    fi

    if command -v java >/dev/null 2>&1; then
        command -v java
        return 0
    fi

    return 1
}

install_java() {
    log "Installing a Java runtime."

    if command -v apt-get >/dev/null 2>&1; then
        apt-get update -qq
        apt-get install -y openjdk-21-jre-headless || apt-get install -y openjdk-17-jre-headless
    elif command -v dnf >/dev/null 2>&1; then
        dnf install -y java-21-openjdk-headless || dnf install -y java-17-openjdk-headless
    elif command -v yum >/dev/null 2>&1; then
        yum install -y java-21-openjdk-headless || yum install -y java-17-openjdk-headless
    elif command -v zypper >/dev/null 2>&1; then
        zypper --non-interactive install java-21-openjdk-headless || \
            zypper --non-interactive install java-17-openjdk-headless
    elif command -v pacman >/dev/null 2>&1; then
        # Arch ships one package per JDK and no separate headless JRE worth pinning, so the JDK
        # is what gets installed. --needed keeps a re-run from reinstalling it.
        pacman -Sy --noconfirm --needed jdk21-openjdk || pacman -Sy --noconfirm --needed jdk-openjdk

        # /usr/bin/java points at whatever archlinux-java calls "default", and a fresh install
        # with no default set leaves it dangling even though a JVM is right there.
        if command -v archlinux-java >/dev/null 2>&1; then
            archlinux-java status 2>/dev/null | grep -q '(default)' || \
                archlinux-java set java-21-openjdk >/dev/null 2>&1 || \
                archlinux-java fix >/dev/null 2>&1 || true
        fi
    elif command -v apk >/dev/null 2>&1; then
        apk add --no-cache openjdk21-jre-headless || apk add --no-cache openjdk17-jre-headless
    else
        return 1
    fi

    return 0
}

JAVA_BIN="$(find_java || true)"
JAVA_OK=0

if [ -n "$JAVA_BIN" ]; then
    JAVA_MAJOR="$(java_major "$JAVA_BIN")"

    if [ -n "$JAVA_MAJOR" ] && [ "$JAVA_MAJOR" -ge "$MIN_JAVA" ] 2>/dev/null; then
        JAVA_OK=1
    fi
fi

if [ "$JAVA_OK" -eq 0 ]; then
    if [ "$IS_ROOT" -eq 1 ]; then
        install_java || die "No supported package manager found. Install Java $MIN_JAVA or newer and run this again."

        JAVA_BIN="$(find_java || true)"
        [ -n "$JAVA_BIN" ] || die "Java was installed but no java binary was found on PATH."

        JAVA_MAJOR="$(java_major "$JAVA_BIN")"
        [ -n "$JAVA_MAJOR" ] && [ "$JAVA_MAJOR" -ge "$MIN_JAVA" ] 2>/dev/null || \
            die "The installed Java is older than $MIN_JAVA. Install Java $MIN_JAVA or newer and run this again."
    else
        die "Java $MIN_JAVA or newer is required. Install it (for example: sudo apt install openjdk-21-jre-headless, or sudo pacman -S jdk21-openjdk) and run this again."
    fi
fi

log "Using Java at $JAVA_BIN."

# ----------------------------------------------------------------------------------- the user

if [ "$USER_INSTALL" -eq 0 ]; then
    if ! id "$SERVICE_USER" >/dev/null 2>&1; then
        log "Creating the $SERVICE_USER system user."

        if command -v useradd >/dev/null 2>&1; then
            useradd --system --home-dir "$DATA_DIR" --shell /usr/sbin/nologin "$SERVICE_USER" 2>/dev/null || \
                useradd --system --home-dir "$DATA_DIR" --shell /bin/false "$SERVICE_USER"
        elif command -v adduser >/dev/null 2>&1; then
            adduser -S -H -h "$DATA_DIR" "$SERVICE_USER"
        else
            die "Neither useradd nor adduser is available; create the $SERVICE_USER user and run this again."
        fi
    fi
fi

mkdir -p "$INSTALL_DIR" "$DATA_DIR"

# -------------------------------------------------------------------------------------- the jar

TMP_DIR="$(mktemp -d 2>/dev/null || mktemp -d -t pano-node)"
trap 'rm -rf "$TMP_DIR"' EXIT INT TERM

EXPECTED_SHA=""

if download_optional "$SHA_URL" "$TMP_DIR/sha256"; then
    EXPECTED_SHA="$(cut -d' ' -f1 < "$TMP_DIR/sha256" | tr -d '\r\n')"
fi

TARGET_JAR="$INSTALL_DIR/$JAR_NAME"
NEED_DOWNLOAD=1

# An install that already has this exact jar is left alone, so re-running the command to re-pair
# a node does not pull 60 MB again.
if [ -f "$TARGET_JAR" ] && [ -n "$EXPECTED_SHA" ]; then
    if [ "$(sha256_of "$TARGET_JAR")" = "$EXPECTED_SHA" ]; then
        NEED_DOWNLOAD=0
        log "$TARGET_JAR is already up to date."
    fi
fi

if [ "$NEED_DOWNLOAD" -eq 1 ]; then
    log "Downloading pano-node $PANO_VERSION."

    download "$JAR_URL" "$TMP_DIR/$JAR_NAME"

    if [ -n "$EXPECTED_SHA" ]; then
        ACTUAL_SHA="$(sha256_of "$TMP_DIR/$JAR_NAME")"

        if [ -z "$ACTUAL_SHA" ]; then
            log "No sha256 tool on this host; the download could not be verified."
        elif [ "$ACTUAL_SHA" != "$EXPECTED_SHA" ]; then
            die "The downloaded jar does not match its published checksum."
        else
            log "Checksum verified."
        fi
    else
        log "The release publishes no checksum; the download could not be verified."
    fi

    mv "$TMP_DIR/$JAR_NAME" "$TARGET_JAR"
fi

chmod 0644 "$TARGET_JAR"

if [ "$USER_INSTALL" -eq 0 ]; then
    chown -R "$SERVICE_USER" "$DATA_DIR" 2>/dev/null || true
    # The daemon replaces its own jar when Pano pushes an update (it stages the download, exits
    # with 75 and systemd starts it again), so the install directory must belong to it too.
    chown -R "$SERVICE_USER" "$INSTALL_DIR" 2>/dev/null || true
fi

# ---------------------------------------------------------------------------------- the service

if [ "$USER_INSTALL" -eq 1 ]; then
    log "Installed to $INSTALL_DIR."
    log "Start it with:"
    log "  \"$JAVA_BIN\" -jar \"$TARGET_JAR\" --data \"$DATA_DIR\" --pano \"$PANO_URL\""
    exit 0
fi

if ! command -v systemctl >/dev/null 2>&1; then
    log "This host has no systemd. Start the node yourself with:"
    log "  \"$JAVA_BIN\" -jar \"$TARGET_JAR\" --data \"$DATA_DIR\" --pano \"$PANO_URL\""
    exit 0
fi

ENV_DIR="/etc/pano-node"
ENV_FILE="$ENV_DIR/$SERVICE_NAME.env"

mkdir -p "$ENV_DIR"

# The pairing credential lives here rather than in the unit, because a unit file is world
# readable and this is a secret. It is single use: the daemon ignores it once it has paired, and
# the file can be deleted afterwards.
{
    echo "PANO_URL=$PANO_URL"
    if [ -n "$PAIR_CODE" ]; then
        echo "PANO_PAIR_CODE=$PAIR_CODE"
    fi
    if [ -n "$BOOTSTRAP_TOKEN" ]; then
        echo "PANO_BOOTSTRAP_TOKEN=$BOOTSTRAP_TOKEN"
    fi
    if [ -n "$NODE_NAME" ]; then
        echo "PANO_NODE_NAME=$NODE_NAME"
    fi
    echo "PANO_NODE_DATA=$DATA_DIR"
} > "$ENV_FILE"

chmod 0600 "$ENV_FILE"
chown "$SERVICE_USER" "$ENV_FILE" 2>/dev/null || true

cat > "/etc/systemd/system/$SERVICE_NAME.service" <<UNIT
[Unit]
Description=Pano node daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=$SERVICE_USER
EnvironmentFile=-$ENV_FILE
ExecStart=$JAVA_BIN -jar $TARGET_JAR --data $DATA_DIR
WorkingDirectory=$DATA_DIR
Restart=always
RestartSec=5
# 75 is the daemon's "I staged an update of myself, start me again" exit code; systemd has to
# treat it as a normal restart rather than as a failure. 78 (removed from Pano, see below) and 143
# (the JVM leaving on the SIGTERM of systemctl stop) are clean exits too, not a failed unit.
SuccessExitStatus=75 78 143
# 78 is the daemon saying Pano removed this node: it has deleted what it held and left only a
# marker, so systemd must stop restarting it rather than start a daemon with nothing to do.
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable "$SERVICE_NAME" >/dev/null 2>&1 || true
systemctl restart "$SERVICE_NAME"

log "pano-node is installed and running."
log "Check it with: systemctl status $SERVICE_NAME"
